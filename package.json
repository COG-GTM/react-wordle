    "lint-staged": "^12.3.7",
    "prettier": "2.6.1",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "src/*.{js,jsx,ts,tsx,json,css,scss,md}": "prettier --write --ignore-unknown"
